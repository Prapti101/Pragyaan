GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SIM_THRESHOLD=0.55
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/copilot.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
# Optional: Gemini model name (the old gemini-1.5-flash has been retired)
GEMINI_MODEL=gemini-3.8-flash
# Knowledge Hub: where uploaded files are stored, and the similarity a document
# passage needs before the assistant answers from it
DOCS_DIR=./data/documents
DOC_SIM_THRESHOLD=0.45
